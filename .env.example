# Frontend - Supabase (REQUERIDO)
VITE_SUPABASE_URL=tu_url_de_supabase_aqui
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_aqui
VITE_API_URL=http://localhost:8001

# Backend - Supabase (Opcional - solo si usas desde Python)
SUPABASE_URL=tu_url_de_supabase_aqui
SUPABASE_KEY=tu_clave_service_role_aqui

# Backend - API Configuration
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://localhost:8081"]
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
FALLBACK_THRESHOLD=0.45
MAX_PICTOGRAMS=5
SEMANTIC_MEMORY_ENABLED=true
SEMANTIC_MEMORY_DATASET=data/processed/dialogos_train_kids.csv
SEMANTIC_MEMORY_SAMPLES_PER_INTENT=400
SEMANTIC_MEMORY_SCORE_CUTOFF=78

# Optional - LLM Configuration
LLM_PROVIDER=
OPENAI_API_KEY=
